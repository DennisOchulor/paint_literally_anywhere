{
	"schemaVersion": 1,
	"id": "paint_literally_anywhere",
	"version": "${version}",
	"name": "Paint Literally Anywhere",
	"description": "The world is (literally) your canvas!",
	"authors": [
		"Ninjaking312"
	],
	"contact": {
		"sources": "https://github.com/DennisOchulor/paint_literally_anywhere",
		"homepage": "https://modrinth.com/mod/paint-literally-anywhere"
	},
	"license": "MIT",
	"icon": "assets/paint_literally_anywhere/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.dennisochulor.paint_literally_anywhere.PLAMod"
		],
		"client": [
          "io.github.dennisochulor.paint_literally_anywhere.client.PLAModClient"
		],
		"fabric-datagen": [
          "io.github.dennisochulor.paint_literally_anywhere.client.datagen.ModDataGenerator"
		]
	},
	"mixins": [
		"paint_literally_anywhere.mixins.json",
		{
			"config": "paint_literally_anywhere.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">=${minecraft_version}",
		"java": ">=25",
		"fabric-api": ">=${fabric_version}"
	},
	"custom": {
		"lithium:options": {
			"mixin.world.raycast": false
		}
	}
}