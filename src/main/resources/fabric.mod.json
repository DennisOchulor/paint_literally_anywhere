{
	"schemaVersion": 1,
	"id": "canvas_block",
	"version": "${version}",
	"name": "Canvas Block",
	"description": "A block you can draw on!",
	"authors": [
		"Ninjaking312"
	],
	"contact": {
		"sources": "https://github.com/DennisOchulor/canvas_block"
	},
	"license": "MIT",
	"icon": "assets/canvas_block/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.dennisochulor.canvas_block.CanvasMod"
		],
		"client": [
			"io.github.dennisochulor.canvas_block.client.CanvasModClient"
		],
		"fabric-datagen": [
			"io.github.dennisochulor.canvas_block.client.datagen.ModDataGenerator"
		]
	},
	"mixins": [
		"canvas_block.mixins.json",
		{
			"config": "canvas_block.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">=${minecraft_version}",
		"java": ">=25",
		"fabric-api": ">=${fabric_version}"
	}
}